#!/usr/bin/env bash
# cage — utility command for the agent-cage (DESIGN §6).
#
#   cage                       drop into an interactive shell in a fresh cage
#   cage docker status         inspect the shared docker sidecar
#   cage docker stop           stop/remove the sidecar
#   cage docker reset          recreate the sidecar (prunes all its images/data)
#
# Day to day the sidecar is invisible; these are for inspecting/recovering it.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/_cage-lib.sh
source "$DIR/_cage-lib.sh"

usage() {
  cat >&2 <<'EOF'
usage:
  cage [-u|--update]         interactive shell in a fresh cage container
                             (--update forces a check for a newer image now)
  cage [-n|--no-update]      skip the registry check; run the cached image as-is
                             (useful on a slow connection)
  cage [--mount-cwd]         also bind-mount the current dir into the cage, so
                             the shell can run from outside the work roots
  cage [--kube]              mint short-lived, read-only kubectl tokens for the
                             clusters in ~/.config/agent-cage/kube-contexts and
                             mount them into the shell
  cage docker status|stop|reset
EOF
}

# Leading flags, only meaningful for `shell`: -u/--update forces an image-freshness
# check this launch (ignoring the pull interval); -n/--no-update skips the check
# and uses the cached image as-is; --mount-cwd binds the current dir into the cage;
# --kube mints and mounts read-only kubectl tokens.
while [ $# -gt 0 ]; do
  case "${1:-}" in
  -u | --update)
    CAGE_FORCE_PULL=1
    shift
    ;;
  -n | --no-update)
    CAGE_NO_PULL=1
    shift
    ;;
  --mount-cwd)
    CAGE_MOUNT_CWD=1
    shift
    ;;
  --kube)
    CAGE_KUBE_ENABLED=1
    shift
    ;;
  *) break ;;
  esac
done

cmd="${1:-shell}"
case "$cmd" in
shell)
  cage_lazy_pull
  cage_sidecar_ensure || cage_err "continuing without a healthy docker sidecar"
  declare -a RUN_ARGS
  cage_build_run_args
  exec podman run -it "${RUN_ARGS[@]}" "$CAGE_IMAGE" bash -l
  ;;
docker)
  case "${2:-status}" in
  ensure) cage_sidecar_ensure ;; # used internally by claude-cage
  status) cage_sidecar_status ;;
  stop) cage_sidecar_stop ;;
  reset) cage_sidecar_reset ;;
  *)
    usage
    exit 1
    ;;
  esac
  ;;
-h | --help | help)
  usage
  ;;
*)
  usage
  exit 1
  ;;
esac
