#!/usr/bin/env python3
# Stand-in for wl-paste inside the cage (DESIGN §9). Claude Code shells out to
# `wl-paste -l` / `wl-paste --type image/png` to paste images; this forwards those
# to the host's image-only clipboard broker (bin/_cage-clip-broker). Text pastes
# and any other usage are refused.

import socket
import sys

SOCK = "/run/cage/clipboard.sock"


def request(line):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(10)
            s.connect(SOCK)
            s.sendall(line.encode() + b"\n")
            chunks = []
            while chunk := s.recv(65536):
                chunks.append(chunk)
            return b"".join(chunks)
    except OSError:
        return b""


def main(argv):
    mime = None
    list_types = False
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-l", "--list-types"):
            list_types = True
        elif arg in ("-t", "--type") and i + 1 < len(argv):
            i += 1
            mime = argv[i]
        elif arg.startswith("--type="):
            mime = arg.split("=", 1)[1]
        elif arg not in ("-n", "--no-newline"):
            return 1
        i += 1

    if list_types:
        out = request("LIST")
    elif mime:
        out = request(f"GET {mime}")
    else:
        print("wl-paste (agent-cage): only image types are available", file=sys.stderr)
        return 1

    if not out:
        return 1
    sys.stdout.buffer.write(out)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
